 async function deleteAllTasks() {
    setError("");
    setSaving(true);
    try {
      // Use the existing DELETE endpoint for every task, including filtered-out tasks.
      for (const task of tasks) {
        const response = await fetch(`${API_URL}/${encodeURIComponent(task.id)}`, {
          method: "DELETE",
        });
        if (!response.ok) throw new Error("Could not delete all tasks. Please try again.");
        setTasks(current => current.filter(item => item.id !== task.id));
      }
    } catch (error) {
      setError(error.message);
    } finally {
      setSaving(false);
    }
  }
